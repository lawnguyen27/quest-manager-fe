# Vite: baked in at docker image build time.
# Same Docker network as gateway (nginx proxy /api): keep default /api.
# Vercel / public API: https://api.example.com/api (no trailing issues — match your gateway paths)

VITE_API_BASE_URL=/api

# GitLab Registry (CI). VPS pull:
# DOCKER_REGISTRY=registry.gitlab.com/your-group/your-frontend-project
# DOCKER_TAG=<commit_short_sha>
DOCKER_REGISTRY=
DOCKER_TAG=
